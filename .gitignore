# multi-agent / cross-model レビューの出力先（コミット対象外）
.review-results/

# Claude Code のローカル作業状態（プランなど）
.claude/

# Node / ビルド成果物
node_modules/
dist/
.wrangler/

# 環境変数
.dev.vars
.env*.local

# wrangler types が生成（npm install の prepare で再生成される）
worker-configuration.d.ts

# tsc -b（typecheck）が生成する差分ビルド情報
*.tsbuildinfo

# シードSQLは生成物（data/ と scripts/seed.ts から再生成できる）
db/seed.generated.sql

# Claude Code の個人ローカル設定（コミットしない）
.claude/settings.local.json

# 提出資料のビルド成果物（deck/build.js から再生成できる）
deck/*.pptx
deck/*.pdf
deck/slide-*.jpg

# soffice / pdftoppm を deck/ の外から叩いたときの取りこぼし対策
# （build.js 自身は __dirname 基準なので必ず deck/ へ書き出す）
tabi-concierge-tokyo-submission.pptx
tabi-concierge-tokyo-submission.pdf

# Playwright MCP の作業ファイル（スナップショット・撮影の中間物）
.playwright-mcp/

# Codex CLI のローカル環境設定
.codex/
