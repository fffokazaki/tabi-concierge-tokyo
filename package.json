{
  "name": "tabi-concierge-tokyo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "旅コンシェルジュTOKYO — 東京都オープンデータを出典付きで届けるAI旅行ガイド",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run --project frontend",
    "test:worker": "vitest run --project worker",
    "typecheck": "tsc -b --noEmit",
    "cf-typegen": "wrangler types",
    "prepare": "wrangler types",
    "test:scripts": "vitest run --project scripts",
    "ace:check-playbook-frontmatter": "node scripts/ace/sync-playbook-frontmatter.ts docs/08-knowledge/PLAYBOOK.md --check",
    "ace:check-entry-format": "node scripts/ace/check-entry-format.ts docs/08-knowledge/PLAYBOOK.md",
    "ace:sync-playbook-frontmatter": "node scripts/ace/sync-playbook-frontmatter.ts docs/08-knowledge/PLAYBOOK.md --write",
    "data:fetch": "node scripts/fetch-data.ts",
    "db:migrate:local": "wrangler d1 migrations apply tabi-concierge-tokyo --local",
    "db:migrate": "wrangler d1 migrations apply tabi-concierge-tokyo --remote",
    "db:seed:local": "node scripts/seed.ts && wrangler d1 execute tabi-concierge-tokyo --local --file=db/seed.generated.sql",
    "db:seed": "node scripts/seed.ts && wrangler d1 execute tabi-concierge-tokyo --remote --file=db/seed.generated.sql",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.21.0",
    "hono": "^4.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
