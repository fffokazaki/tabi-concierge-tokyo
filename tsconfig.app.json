{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  },
  // shared/ はコア3操作の入出力型（worker とブラウザの共有）。
  // src から import されたファイルは include が無くても検査されるが、まだどこからも
  // import されていないファイルは検査対象に入らない（実測: include を外すと未 import の
  // ファイルに型エラーを入れても tsc -b が 0 件で通る）。shared/ 全体を常に検査するため入れる
  "include": ["src", "shared"]
}
